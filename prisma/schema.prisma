datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  OWNER
  DISPATCHER
  RIDER
}

enum ErrandStatus {
  AVAILABLE
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

// 1. User Table (3NF: Atomic Names, Foreign Keys for Role & Addresses)
// Operational staff only (Owner/Dispatcher/Rider) — customer accounts live in
// CustomerAccount/CustomerInformation/CustomerTransaction below.
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         RoleType
  firstName    String
  middleName   String?
  lastName     String
  email        String   @unique
  phone        String
  avatar       String?
  status       String   @default("Active")
  version      Int      @default(1)
  updatedBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // First-login email ownership proof. The two defaults are deliberately
  // asymmetric: an account created through the dashboard already has validated
  // names and an email (profileCompleted), but nobody has yet proven that the
  // address is reachable (emailVerified) — so it is challenged once, on its
  // first sign-in. Only the seeded bootstrap admin starts profile-incomplete.
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  profileCompleted Boolean   @default(true)

  expoPushToken String?

  errandsAsRider          Errand[]                 @relation("RiderErrands")
  trackPoints             ErrandTrackPoint[]       @relation("RiderTrackPoints")
  dispatchLogs            DispatchLog[]            @relation("DispatcherLogs")
  declinesMade            ErrandDeclineReason[]     @relation("DispatcherDeclines")
  ratingsReceived         Rating[]
  notifications           Notification[]
  paymentEnabledErrands   Errand[]                 @relation("PaymentEnabledBy")
  paymentsConfirmed       ErrandPayment[]          @relation("ErrandPaymentsConfirmed")
  connectivityIncidents   ConnectivityIncident[]
  settlements             SettlementRecord[]
  proofImages             ErrandProofImage[]
  commissions             RiderCommission[]
  exceptionReviews        ExceptionReview[]        @relation("ExceptionReviews")
  updatedByUser           User?                    @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedRecords          User[]                   @relation("UserUpdatedBy")
  riderLoginSessions      RiderLoginSession[]
  riderStatusLogs         RiderStatusLog[]
  accountModificationLogs AccountModificationLog[]
  verificationCodes       EmailVerificationCode[]  @relation("UserVerificationCodes")
  profilePhoto            RiderProfilePhoto?
  presence                RiderPresence?

  @@map("users")
}

// 1b. Staff Profile Photos (dedicated storage for OWNER/DISPATCHER/RIDER avatars)
//
// Mirrors CustomerProfilePhoto rather than reusing User.avatar, which is a plain
// String — a VarChar that a base64 image does not fit in. Splitting the bytes off
// the User row also keeps every ordinary user read (auth, the dispatcher roster,
// the errand joins) from dragging a megabyte of image along with it.
model RiderProfilePhoto {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoData String   @db.LongText
  mimeType  String   @db.VarChar(50)
  fileSize  Int
  fileName  String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rider_profile_photos")
}

// 1c. Rider Presence (durable mirror of the in-process presence/position caches)
//
// riderPositionStore and riderPresenceStore both live in Node memory and both
// fill only as a side effect of an errand already in progress, so an idle rider
// was invisible to dispatch and a server restart erased the whole fleet's state.
// This row is written by the rider's low-rate beacon, independently of any
// errand, so "who can I dispatch to right now" has a durable answer.
//
// One row per rider, overwritten in place: this is current state, not history.
// The breadcrumb trail in ErrandTrackPoint remains the audit record.
model RiderPresence {
  id        Int      @id @default(autoincrement())
  riderId   Int      @unique
  rider     User     @relation(fields: [riderId], references: [id], onDelete: Cascade)

  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  headingDeg     Float?

  onDuty             Boolean @default(false)
  backgroundLocation Boolean @default(false)
  notifications      Boolean @default(false)
  exactAlarms        Boolean @default(false)
  // 'wifi' | 'cellular' | 'none' — recorded for diagnosis, never for eligibility.
  connectivity       String? @db.VarChar(16)
  // The cadence the device reported beaconing at. The staleness window is derived
  // from it rather than fixed, because a threshold shorter than the interval marks
  // a healthy rider lost between every pair of beacons.
  beaconIntervalMs   Int?

  // Device clock at the fix, and server clock at receipt. Both, because the gap
  // between them is the only way to tell a slow network from a wrong clock.
  recordedAt DateTime?
  lastBeaconAt DateTime?
  // Set only by an explicit shutdown beacon. Null means any absence is inferred.
  shutdownAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rider_presence")
}



// 1b. Customer Account Table (3NF: auth/identity only, split from operational `users`)
model CustomerAccount {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  passwordHash  String
  email         String   @unique
  status        String   @default("Active")
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  information             CustomerInformation?
  // Expo push token for this customer's device.
  //
  // Customers had none, which is why the only thing that could reach them was
  // the in-app panel — a dispatcher accepting an errand was silent unless the
  // customer happened to be looking at the waiting screen. `User` has carried
  // one since the rider app shipped; this is the same field for the other half
  // of the conversation. Nullable because a customer may decline the OS prompt,
  // and every push path treats a missing token as "skip", never as an error.
  expoPushToken           String?

  profilePhoto            CustomerProfilePhoto?
  transactions            CustomerTransaction[]
  errands                 Errand[]                 @relation("CustomerErrands")
  savedDeliveryLocations  SavedDeliveryLocation[]
  notifications           Notification[]
  verificationCodes       EmailVerificationCode[]
  accountModificationLogs AccountModificationLog[]
  passwordResetAttempts   PasswordResetAttempt[]
  proofImages             ErrandProofImage[]

  @@map("customer_accounts")
}

// 1c. Customer Information Table (3NF: profile/contact details)
model CustomerInformation {
  id         Int             @id @default(autoincrement())
  customerId Int             @unique
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  middleName String?
  lastName   String
  birthdate  DateTime?       @db.Date
  phone      String
  avatar     String?         @db.LongText
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("customer_information")
}

// 1d. Customer Profile Photos Table (Dedicated 3NF storage for customer avatar photo)
model CustomerProfilePhoto {
  id         Int             @id @default(autoincrement())
  customerId Int             @unique
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  photoData  String          @db.LongText
  mimeType   String          @db.VarChar(50)
  fileSize   Int
  fileName   String?         @db.VarChar(255)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("customer_profile_photos")
}

// 1d. Customer Transaction Table (3NF: order/payment history, one row per errand)
model CustomerTransaction {
  id            Int             @id @default(autoincrement())
  customerId    Int
  customer      CustomerAccount @relation(fields: [customerId], references: [id])
  errandId      String          @unique
  errand        Errand          @relation(fields: [errandId], references: [id])
  amount        Float
  paymentMethod String          @default("COD")
  status        String          @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("customer_transactions")
}

// How the purchase handling fee is charged for a stop of this kind.
//
// The fee used to depend on basket value alone, with no idea what sort of shop
// the rider was standing in — so a ₱3,500 restaurant order was charged a "grocery
// fee" of ₱350. What decides it is the store type, which is why the mode lives
// on the category.
//
// The AMOUNTS stay in RateConfig. Only the mode is per-category, so the flat
// figure and the percentage are still edited in one place and cannot drift
// between six categories.
enum HandlingFeeMode {
  // Flat below RateConfig.groceryFeeThreshold, percentage at or above it.
  THRESHOLD
  // Always the flat amount, whatever the basket is worth.
  FLAT
  // Always the percentage of basket value.
  PERCENT
  // No handling fee at all for this store type.
  NONE
}

// 3. Merchant Categories Table (3NF)
model MerchantCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Defaulted to THRESHOLD so shipping this changes nothing: every category
  // keeps behaving exactly as it did until an owner deliberately moves one.
  handlingFeeMode HandlingFeeMode @default(THRESHOLD)

  // Service time ("dwell") for a stop of this kind - how long the rider is
  // actually inside the store, as opposed to travelling. This is the single
  // biggest difference between an errand ETA and a food-delivery ETA: a
  // supermarket run is mostly standing in an aisle and a queue.
  //
  // Seeded with sensible defaults, then replaced by real percentiles computed
  // from DwellObservation rows by jobs/dwellLearning.ts. P50 drives the low end
  // of the quoted ETA range and P80 the high end, because queue time has a long
  // right tail and a mean would under-promise most of the time.
  dwellP50Seconds  Int       @default(600)
  dwellP80Seconds  Int       @default(1200)
  dwellSampleCount Int       @default(0)
  dwellUpdatedAt   DateTime?

  // How close the rider must be for a stop of this kind to count as reached.
  //
  // Per category for the same reason dwell is: a supermarket occupies a whole
  // block and its car park pushes the rider further from the pin than a
  // roadside carinderia ever could. A single radius either fires late at the
  // supermarket or fires from across the street at the carinderia.
  //
  // Defaulted to the 75 m the breadcrumb geofence has always used, so existing
  // categories behave exactly as before until an owner changes one.
  geofenceRadiusMeters Int @default(75)

  places            VerifiedPlace[]
  pinpoints         ErrandPinpoint[]
  dwellObservations DwellObservation[]
  image             StoreCategoryImage?

  @@map("merchant_categories")
}

// 3b. Store Category Image Table (3NF: at most one hero photo per category)
//
// Kept out of `merchant_categories` on purpose. The photo is a LongText base64
// blob measured in hundreds of kilobytes, and `merchant_categories` is read on
// nearly every customer app launch (the Bento grid) and on every dispatcher
// store pick. Holding the blob in a side table lets those reads stay narrow -
// the list endpoint selects only `mimeType`/`updatedAt` from here, and the
// bytes are fetched once per category, by id, and then cached on the device.
//
// `onDelete: Cascade` because an image with no category is dead weight, and
// `categoryId @unique` enforces the one-photo-per-category rule in the schema
// rather than in application code.
model StoreCategoryImage {
  id         Int              @id @default(autoincrement())
  categoryId Int              @unique
  category   MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageData  String           @db.LongText
  mimeType   String           @db.VarChar(50)
  fileSize   Int
  fileName   String?          @db.VarChar(255)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("store_cat_image")
}

// 4. Payment Modes Table (3NF)
model PaymentMode {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())

  errands           Errand[]
  paymentSelections PaymentSelection[]

  @@map("payment_modes")
}

// 5. Errand Table (3NF: Foreign Key references to Customer, Rider, PaymentMode, Addresses)
model Errand {
  id                String       @id @default(uuid())
  category          String
  description       String
  pickupAddress     String
  deliveryAddress   String
  deliveryLatitude  Float?
  deliveryLongitude Float?
  estimatedCost     Float        @default(0)
  deliveryFee       Float        @default(50)
  tip               Float        @default(0)
  totalCost         Float        @default(50)
  status            ErrandStatus @default(PENDING)

  // Number of store categories selected at creation time (1-3). Deliberately
  // decoupled from pabiliDetails.length/pabiliItemRequests.length — those hold
  // the real item list, whose size has nothing to do with how many stores the
  // rider must visit. Persisted so later repricing passes (savePinpoints,
  // confirmPaymentSelection) keep using the original store count even after a
  // dispatcher edits item names/quantities.
  storeCount Int @default(1)

  customerId Int
  customer   CustomerAccount @relation("CustomerErrands", fields: [customerId], references: [id])

  riderId Int?
  rider   User? @relation("RiderErrands", fields: [riderId], references: [id])

  paymentModeId Int?
  paymentMode   PaymentMode? @relation(fields: [paymentModeId], references: [id])

  // Dispatcher-side gate for the chat-embedded payment-selection flow: the
  // customer cannot POST /errands/:id/payment-selection until this is set —
  // see paymentSelectionService.confirmPaymentSelection's guard.
  paymentEnabledAt             DateTime?
  paymentEnabledByDispatcherId Int?
  paymentEnabledByDispatcher   User?     @relation("PaymentEnabledBy", fields: [paymentEnabledByDispatcherId], references: [id])

  // Set once the assigned rider taps "Mark Items Purchased" (see
  // errandService.markItemsPurchased) — the customer-facing progress stepper
  // uses this to distinguish "traveling to store" from "in route to you".
  // Mirrors paymentEnabledAt's nullable-timestamp-as-gate pattern.
  itemsPurchasedAt DateTime?

  // The receipt came in higher than the customer agreed to, and the goods are
  // being held until the office arranges the difference.
  //
  // Stamped by markItemsPurchased when the real receipt total clears the agreed
  // basket by more than OVERAGE_ESCALATION_PESOS, cleared when a dispatcher
  // confirms a TOP_UP covering it. While escalated and unresolved, the rider
  // cannot advance the errand to DELIVERED: the company has fronted more money
  // than the downpayment covers, and handing the goods over would be the moment
  // that becomes unrecoverable.
  //
  // Same nullable-timestamp-as-gate pattern as paymentEnabledAt and
  // itemsPurchasedAt above.
  overageEscalatedAt DateTime?
  overageResolvedAt  DateTime?

  // Lifecycle timestamps. Before these existed the only way to measure how long
  // a delivery took was `updatedAt - createdAt`, which is wrong the moment
  // anything touches the row after delivery. Dwell learning and on-time
  // reporting both read these.
  assignedAt  DateTime?
  acceptedAt  DateTime?
  deliveredAt DateTime?
  completedAt DateTime?

  // Road-network route as last computed (see services/routingService.ts).
  // distanceKm is what pricing actually bills on — persisted rather than
  // recomputed-and-discarded, closing the gap in docs/errand_pricing_formula.md
  // section 4.3. routeProvider/`degraded` record which engine produced it so a
  // fallback estimate is never mistaken for a measurement.
  distanceKm           Float?
  routeDistanceMeters  Int?
  routeDurationSeconds Int?
  routeGeometry        String?   @db.Text
  routeProvider        String?   @db.VarChar(20)
  routedAt             DateTime?

  // How deliveryFee above was arrived at. StandardPricingStrategy has always
  // returned these four components and recalculateFee has always thrown them
  // away, keeping only the total — which left the customer with a number and no
  // explanation, and led CheckoutScreen to reimplement pricing client-side (on a
  // hardcoded 2.5 km) just to have something to show.
  //
  // The four sum to deliveryFee minus baseFee. estimatedCost is deliberately NOT
  // among them: that is the customer's item money the company fronts, it is not a
  // fee, and no surface may fold it into one.
  multiStoreFee   Float?
  groceryFee      Float?
  nonCodFee       Float?
  distanceFee     Float?
  feeCalculatedAt DateTime?

  // What the customer agreed the handling fee would be, and on what basket.
  //
  // Stamped when they confirm the itemised breakdown, and never exceeded after.
  // markItemsPurchased overwrites estimatedCost with the REAL receipt total —
  // after the rider has already bought the goods, so there is no moment left in
  // which to ask the customer to consent to a bigger number. Without a ceiling a
  // ₱1,000 estimate ringing up at ₱1,200 silently became ₱120 against an agreed
  // ₱50. The ceiling is a one-way ratchet: a smaller real basket still lowers
  // the fee.
  //
  // Null on errands confirmed before this existed, and on errands not yet
  // confirmed — decideHandlingFee treats null as "no ceiling", which is exactly
  // the behaviour that came before.
  quotedHandlingBasket Float?
  quotedHandlingFee    Float?

  // The whole fare the customer agreed to, stamped when they confirm.
  //
  // The handling ceiling above protects one component. The rest of the fare had
  // no such protection, and recalculateFee re-measures the road on every call —
  // including the one markItemsPurchased makes when the rider uploads a receipt.
  // Distance is billed in whole started kilometres, so an ordinary difference
  // between routing engines (the same Tacurong leg measures 2716 m on Google,
  // 2724 m stored, 2756 m on OSRM) can cross a kilometre boundary and move the
  // fare by a whole ₱10 with nobody deciding it. A customer quoted ₱90 was
  // charged ₱80 that way; the same mechanism charges ₱100 just as easily.
  //
  // Frozen rather than capped: the figure the customer agreed to is the figure
  // they pay. A ceiling would still have let ₱90 fall to ₱80, which is the
  // mismatch this exists to stop.
  //
  // Null on errands confirmed before this existed, and on errands not yet
  // confirmed — recalculateFee treats null as "not agreed yet, price it live",
  // which is exactly the behaviour that came before.
  quotedDeliveryFee Float?

  // Why the handling fee is what it is: mode, tier, basket, evidence, what the
  // rule alone produced, the relief cap, the ceiling, and which one won.
  //
  // "Why ₱50 and not 10%?" is a question the dispatcher, the owner and the
  // customer all end up asking, and the fee used to arrive as a bare figure with
  // no account of itself. See patterns/pricingStrategy.decideHandlingFee.
  handlingFeeDecision Json?

  // ETA is stored as a range, never a single number: an errand includes time
  // standing in a queue, which is inherently uncertain. See services/etaService.ts.
  etaLowAt      DateTime?
  etaHighAt     DateTime?
  etaComputedAt DateTime?
  etaIsDegraded Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pabiliDetails         PabiliDetail[]
  pabiliItemRequests    PabiliItemRequest[]
  declineReasons ErrandDeclineReason[]
  dispatchLogs          DispatchLog[]
  pinpoints             ErrandPinpoint[]
  transaction           CustomerTransaction?
  paymentSelection      PaymentSelection?
  payments         ErrandPayment[]
  rating                Rating?
  connectivityIncidents ConnectivityIncident[]
  settlement            SettlementRecord?
  trackPoints           ErrandTrackPoint[]
  dwellObservations     DwellObservation[]
  exceptionReviews ExceptionReview[]
  proofImages           ErrandProofImage[]
  commission            RiderCommission?

  @@map("errands")
}

// 6. Pabili Details Table (3NF: Separated itemized list)
model PabiliDetail {
  id                Int      @id @default(autoincrement())
  errandId          String
  errand            Errand   @relation(fields: [errandId], references: [id], onDelete: Cascade)
  itemName          String
  // Which of the errand's selected store categories this item was requested
  // from (e.g. "Pharmacy", "Bakery") — nullable because dispatcher-added items
  // (via the items-edit endpoint) aren't necessarily tied to one of the
  // customer's original category picks.
  storeCategory     String?
  quantity          Int      @default(1)
  unitPrice         Float    @default(0)
  estimatedSubtotal Float    @default(0)
  createdAt         DateTime @default(now())

  // Which stop the rider buys this at.
  //
  // PabiliItemRequest carries the same column for the customer's original ask.
  // This one is the WORKING answer: when a dispatcher splits an order across
  // shops the customer filed under one category, only the working copy records
  // the split, and the rider shops from the working copy. Without this the
  // rider's checklist showed the customer's own grouping back to them and the
  // dispatcher's correction was invisible.
  pinpointId Int?
  pinpoint   ErrandPinpoint? @relation(fields: [pinpointId], references: [id], onDelete: SetNull)

  @@index([pinpointId])
  @@map("pabili_details_tbl")
}

// 6a. Pabili Item Requests Table (3NF: customer's ORIGINAL, immutable item ask —
// an audit-trail record distinct from PabiliDetail, which is the mutable working
// copy a dispatcher may later correct. Never updated/deleted after creation
// except via the Errand's own cascade.)
model PabiliItemRequest {
  id            Int      @id @default(autoincrement())
  errandId      String
  errand        Errand   @relation(fields: [errandId], references: [id], onDelete: Cascade)
  itemName      String
  storeCategory String?
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())

  // Which stop the rider buys this at. Until this existed an item carried only a
  // free-text storeCategory, so "what do I buy at this store" had no answer and
  // the rider had to infer it from the category name.
  //
  // Nullable by necessity: items are captured by the customer at errand creation,
  // before any dispatcher has pinned a store. They attach when pins are saved,
  // and anything still unattached stays visible as a general list rather than
  // vanishing from the rider's view. SetNull so re-pinning never deletes items.
  pinpointId Int?
  pinpoint   ErrandPinpoint? @relation(fields: [pinpointId], references: [id], onDelete: SetNull)

  @@index([pinpointId])
  @@map("pabili_item_requests_tbl")
}

// 6b. Errand Pinpoints Table (3NF: dispatcher-committed store waypoints, max 3 per errand)
model ErrandPinpoint {
  id        Int      @id @default(autoincrement())
  errandId  String
  errand    Errand   @relation(fields: [errandId], references: [id], onDelete: Cascade)
  sequence  Int      @default(0)
  storeName String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  // What kind of store this stop is, which is what decides how long the rider
  // is expected to be inside it (see MerchantCategory dwell fields). Resolved
  // from the matched VerifiedPlace where there is one; nullable because a
  // dispatcher can drop a pin on a store that isn't in the catalogue.
  categoryId Int?
  category   MerchantCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  placeId    String?           @db.VarChar(36)
  place      VerifiedPlace?    @relation("PinnedPlace", fields: [placeId], references: [id], onDelete: SetNull)

  // Where the rider actually settled, when that was a catalogue place other than
  // the one pinned above — the Jollibee Drive-Thru vs Jollibee Center case, which
  // the geofence cannot see because the two are 440 m apart. Observational only:
  // arrivedAt stays null and the stop stays outstanding. Null is the normal case.
  observedPlaceId    String?        @db.VarChar(36)
  observedPlace      VerifiedPlace? @relation("ObservedPlace", fields: [observedPlaceId], references: [id], onDelete: SetNull)
  mismatchDetectedAt DateTime?

  // Set by geofence entry/exit derived from the rider's breadcrumb. The gap
  // between them is one dwell observation.
  arrivedAt  DateTime?
  departedAt DateTime?

  // Routing result for the leg ENDING at this stop.
  legDistanceMeters  Int?
  legDurationSeconds Int?

  // Blocks the route optimizer from reordering this stop. Real errands have
  // ordering constraints the optimizer can't know - buy the hot food last.
  sequenceLocked Boolean @default(false)

  dwellObservations DwellObservation[]
  itemRequests      PabiliItemRequest[]
  // The working item list filed under this stop — what the rider actually buys
  // here after any dispatcher restructuring.
  items             PabiliDetail[]
  proofImages       ErrandProofImage[]

  @@index([errandId])
  @@map("errand_pinpoints_tbl")
}

// 6z. Exception Reviews (who cleared a reconciliation exception, and why)
model ExceptionReview {
  id       Int    @id @default(autoincrement())
  errandId String
  errand   Errand @relation(fields: [errandId], references: [id], onDelete: Cascade)

  // Which of the errand's exceptions this clears. Stored as a string rather
  // than an enum so a kind added to exceptionRules.ts does not need a migration
  // before it can be reviewed.
  kind String @db.VarChar(40)

  reviewerId Int
  reviewer   User @relation("ExceptionReviews", fields: [reviewerId], references: [id])

  // Required. An exception cleared with no stated reason is weak evidence
  // later, which is exactly when it is needed.
  reason String @db.VarChar(500)

  // The exposure AS IT STOOD when this was cleared.
  //
  // An exception is derived, so the figures behind it can move afterwards.
  // Freezing the amount here is what makes the row evidence rather than a
  // pointer to a number that has since changed.
  amountAtRisk Float @default(0)

  resolvedAt DateTime @default(now())

  // Deliberately NOT unique on (errandId, kind): an owner reviewing something a
  // dispatcher already closed writes a second row rather than overwriting the
  // first, so the sequence of who looked and what they concluded survives.
  @@index([errandId])
  @@index([reviewerId, resolvedAt])
  @@map("exception_reviews")
}

// 7. Dispatch Logs Table (3NF: Dispatcher assignment logs)
model DispatchLog {
  id           Int      @id @default(autoincrement())
  errandId     String
  errand       Errand   @relation(fields: [errandId], references: [id], onDelete: Cascade)
  dispatcherId Int
  dispatcher   User     @relation("DispatcherLogs", fields: [dispatcherId], references: [id])
  notes        String?
  dispatchedAt DateTime @default(now())

  // When the dispatcher finished verifying the order WITH the customer and
  // accepted it — distinct from dispatchedAt, which is when they merely opened
  // it and took it out of the queue.
  //
  // Two boundaries, because opening a request now locks it: a claimed errand may
  // be sitting in review with items still being checked, and Steps 1-4 must stay
  // shut until someone has actually said the order is good. Errand.status cannot
  // carry this — PENDING already means both things.
  //
  // Null on every existing row, which is correct: nothing claimed before this
  // shipped went through a verification step.
  verifiedAt   DateTime?

  @@map("dispatch_logs")
}

// 9b. Errand Decline Reasons (why a dispatcher turned a request down)
//
// A dispatcher declining a request used to leave nothing behind: the reason was
// posted to `PATCH /errands/:id/status` and dropped on the floor, so the errand
// simply became CANCELLED and neither the customer nor the owner could ever
// learn why. That is the one thing a customer most wants to know at that moment,
// and the one thing an owner needs to spot a pattern ("all declines this week
// were 'store closed'").
//
// Its own table rather than a column on `errands`, because a reason is a fact
// about a decision made by a person at a time — it has an author and a
// timestamp of its own. Not unique per errand: an errand could in principle be
// reopened and declined again, and losing the earlier reason would defeat the
// point of recording it.
model ErrandDeclineReason {
  id           Int      @id @default(autoincrement())
  errandId     String
  errand       Errand   @relation(fields: [errandId], references: [id], onDelete: Cascade)
  dispatcherId Int
  dispatcher   User     @relation("DispatcherDeclines", fields: [dispatcherId], references: [id])

  reason String @db.VarChar(255)
  // True when the dispatcher typed a free-text reason instead of picking one of
  // the preset options, which is what makes the presets reviewable later: a
  // rising share of custom reasons means the preset list has gone stale.
  isCustom Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([errandId])
  @@index([dispatcherId])
  @@map("errand_decline_reasons")
}

// 10. Service Rates Configuration Table (3NF)
model RateConfig {
  id Int @id @default(1)

  // No column default, deliberately.
  //
  // The base fee is a PRICE, and the database must never invent one. A default
  // meant an incompletely-created config row still priced errands — at a figure
  // nobody chose, indistinguishable from one the owner had set. Every writer
  // (seed, rateConfigRepository.upsert) supplies it explicitly, and the read
  // paths already handle a missing config by refusing to quote rather than
  // falling back (see errandService.quoteErrand's 503).
  baseFee Float

  perKmRate Float @default(10)

  // Multi-store surcharge: charged per store beyond the first, capped at
  // maxAdditionalStores (ErrandFormScreen.tsx caps a customer at 3 store
  // categories total = 1 base + up to 2 additional).
  multiStoreFeePerStore Float @default(30)
  maxAdditionalStores   Int   @default(2)

  // Grocery fee tier: FLAT below the threshold, PERCENTAGE at or above it.
  //
  // A small basket is about the same work whatever it costs, so it pays one
  // predictable handling fee; a large one ties up proportionally more company
  // cash and carries more risk, so it scales with value.
  //
  // The two column names describe what the values ARE (a percentage, a flat
  // amount), not where they apply — so inverting which side each governs needed
  // no data change. See StandardPricingStrategy for the applied rule.
  //
  // 1001, not 1000: the owner's rule is "₱50 at ₱1,000, 10% from ₱1,001", and
  // the comparison is `>=`. The size gate in pricingStrategy.ts admits baskets
  // from ₱1,000, so the flat tier is exactly the ₱1,000 basket plus any long
  // list under it. Crossing the threshold does NOT produce a ₱50 step —
  // marginal relief holds the fee down until the plain percentage is the
  // cheaper of the two, around ₱1,055. See decideHandlingFee.
  groceryFeeThreshold Float @default(1001)
  groceryFeePercent   Float @default(10)
  groceryFeeFlat      Float @default(50)

  // Non-COD handling fee: only applies once a confirmed payment mode isn't
  // COD — currently unreachable in practice (see paymentMethodStrategy.ts's
  // UnavailableStrategy) but modeled now so a future GCash/Bank/Card
  // integration needs no further pricing change.
  // The owner's rule: ₱15 on a purchase of ₱3,000 or more, nothing below it.
  //
  // These were ₱50 above and ₱15 below — the two amounts the wrong way round,
  // charging the larger purchase more than the rule allows and the smaller one a
  // fee it never owed. The column names describe WHERE each applies, not their
  // size, so nothing about the naming caught it, and the owner portal rendered
  // no inputs for them at all until recently — a fee nobody could see was a fee
  // nobody could notice was wrong. rateConfigValidators now refuses High < Low.
  nonCodThreshold Float @default(3000)
  nonCodFeeHigh   Float @default(15)
  nonCodFeeLow    Float @default(0)

  updatedAt DateTime @updatedAt

  @@map("rate_configs")
}

// 11. Saved Delivery Locations (Customer GPS pinpoints, max 5 per customer)
model SavedDeliveryLocation {
  id         Int             @id @default(autoincrement())
  customerId Int
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  address    String
  latitude   Float
  longitude  Float
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@map("saved_delivery_locations")
}

// 12. Token Blocklist Table (Server-Side Session Revocation)
// 12b. User Sessions (one row per signed-in device, for both staff and customers)
//
// Before this table a refresh token was a bare 7-day bearer JWT: whoever held
// the string was the user, it could be replayed forever until it expired, and
// nothing on the server could tell a legitimate refresh from a stolen one. That
// is the trade the 30-day session length would otherwise make much worse.
//
// So the refresh token now carries a `sid` pointing here, and this row holds
// only the SHA-256 of the token, never the token itself - a database read does
// not hand the reader a working credential. Every refresh rotates the token and
// rewrites `tokenHash`, which is what makes theft detectable: if a token that
// has already been rotated away is presented again, either the client replayed
// or someone else is holding a copy, and the whole session is revoked rather
// than guessing which. `previousHash` + `rotatedAt` carve out a few seconds of
// grace so a phone firing several requests at once does not trip that alarm.
//
// No foreign key: staff live in `users` and customers in `customer_accounts`,
// so `subjectType` discriminates and referential integrity is enforced in
// sessionService instead. Deleting an account leaves rows here, which the
// expiry sweep collects.
model UserSession {
  id          String @id @db.VarChar(36)
  subjectId   Int
  subjectType String @db.VarChar(16)
  role        String @db.VarChar(20)

  tokenHash    String    @db.Char(64)
  previousHash String?   @db.Char(64)
  rotatedAt    DateTime?

  // Captured at sign-in and compared on every rotation. A refresh arriving from
  // a different device than the one that signed in is the clearest hijack
  // signal available without asking the user anything.
  deviceId  String? @db.VarChar(80)
  userAgent String? @db.VarChar(300)
  ipAddress String? @db.VarChar(64)

  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(64)

  @@index([subjectType, subjectId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@map("user_sessions")
}

model TokenBlocklist {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("token_blocklist")
}

// 13. Payment Selection Table (3NF: dispatcher-prompted, customer-confirmed
// payment mode per errand — a distinct record from CustomerTransaction, which
// tracks the money/settlement side; this tracks the verification-only choice
// itself, one confirmed row per errand, never overwritten once written).
model PaymentSelection {
  id            String      @id @default(uuid())
  errandId      String      @unique
  errand        Errand      @relation(fields: [errandId], references: [id], onDelete: Cascade)
  paymentModeId Int
  paymentMode   PaymentMode @relation(fields: [paymentModeId], references: [id])
  confirmedAt   DateTime    @default(now())

  @@map("payment_selections")
}

// What a customer actually paid, and when somebody confirmed it.
//
// A LEDGER, not a set of columns on Errand, because the amounts here are facts
// about money that arrived and must never be restated. The downpayment is taken
// off the ESTIMATED basket before the rider buys anything, and
// markItemsPurchased later overwrites estimatedCost with the real receipt total
// — so a derived "half of estimatedCost" would silently change after the
// customer had already paid it. A row cannot change under them.
//
// It also gives the awkward cases somewhere to live instead of a special case:
// a TOP_UP when the receipt came in high, a REFUND when an errand is cancelled
// after the downpayment landed.
enum ErrandPaymentKind {
  // Whatever the customer pays before a rider is sent, through the company's
  // Facebook Page. On the 50% plan that is half the goods; on GCash / Bank
  // Transfer / Card it is the whole bill. One kind, because it is the same act
  // — money arriving out-of-band that a dispatcher has to vouch for — and the
  // amount owed is a property of the PLAN, not of the payment.
  UPFRONT
  TOP_UP // an overage the customer agreed to after the receipt came in higher
  FINAL  // the balance, collected in cash by the rider at the door
  REFUND // money returned, e.g. a cancellation after money had already arrived
}

model ErrandPayment {
  id       String            @id @default(uuid())
  errandId String
  errand   Errand            @relation(fields: [errandId], references: [id], onDelete: Cascade)
  kind     ErrandPaymentKind
  amount   Float

  // Who attested the money arrived, and when.
  //
  // Payment lands on the company's Facebook Page, outside this system — there is
  // no gateway callback to trust, only a person saying they saw it. Recording
  // WHICH person is the whole control: an attestation nobody signed is a figure
  // with no one accountable for it.
  confirmedByUserId Int
  confirmedBy       User     @relation("ErrandPaymentsConfirmed", fields: [confirmedByUserId], references: [id])
  confirmedAt       DateTime @default(now())
  note              String?  @db.VarChar(255)

  // The exact photo that justified this attestation, where one exists. @unique
  // so a single photo can never be stretched to back two different payments —
  // the same anti-reuse guarantee the OCR's same-day check gives at upload time,
  // enforced again at the database layer.
  proofImageId Int?              @unique
  proofImage   ErrandProofImage? @relation(fields: [proofImageId], references: [id], onDelete: SetNull)

  @@index([errandId])
  @@map("errand_payments")
}

// 14. Ratings Table (3NF: one customer rating per errand, tied to the rider
// who handled it)
model Rating {
  id        Int      @id @default(autoincrement())
  errandId  String   @unique
  errand    Errand   @relation(fields: [errandId], references: [id], onDelete: Cascade)
  riderId   Int
  rider     User     @relation(fields: [riderId], references: [id])
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("ratings")
}

// 14b. Email Verification Codes Table (3NF: one row per code issued —
// re-sends create a NEW row rather than overwriting, so failed/expired
// attempts stay in the trail rather than being silently lost)
model EmailVerificationCode {
  id         Int              @id @default(autoincrement())
  customerId Int?
  // Staff (users) codes are keyed by userId, customers by customerId. Exactly
  // one of the two is set; the row is still channel-addressable via `email`.
  userId     Int?
  email      String?
  phone      String?
  customer   CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User?            @relation("UserVerificationCodes", fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int              @default(0)
  createdAt  DateTime         @default(now())

  @@index([customerId])
  @@index([userId])
  @@index([email])
  @@index([phone])
  @@map("email_verification_codes")
}

// 14c. Connectivity Incidents Table (3NF: audit trail of rider device
// connectivity loss — one row per incident, opened on disconnect,
// `reconnectedAt` filled in when the device comes back online)
model ConnectivityIncident {
  id             Int       @id @default(autoincrement())
  riderId        Int
  rider          User      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  errandId       String?
  errand         Errand?   @relation(fields: [errandId], references: [id], onDelete: SetNull)
  disconnectedAt DateTime  @default(now())
  reconnectedAt  DateTime?
  createdAt      DateTime  @default(now())

  @@index([riderId])
  @@map("connectivity_incidents")
}

// 14d. Settlement Records Table (3NF: one row per COD errand's cash
// reconciliation — expectedAmount is the calculated Errand.totalCost at the
// moment of settlement, collectedAmount is what the rider actually turned
// in, variance/status capture the reconciliation outcome)
model SettlementRecord {
  id              Int      @id @default(autoincrement())
  errandId        String   @unique
  errand          Errand   @relation(fields: [errandId], references: [id], onDelete: Cascade)
  riderId         Int
  rider           User     @relation(fields: [riderId], references: [id])
  expectedAmount  Float
  collectedAmount Float
  variance        Float
  status          String

  // Why the cash came back short, in the rider's words.
  //
  // Only set on a SHORT settlement. Collected because a variance with no
  // explanation is a number nobody can act on -- the difference between a
  // customer who paid what they had and a rider who kept the rest is exactly
  // what this line records, and it is the first thing an investigation asks.
  shortReason     String?  @db.VarChar(300)

  // The photo the rider took of the cash (or the GCash/Maya receipt, on a
  // ledger errand) that backs this settlement. @unique for the same reason as
  // ErrandPayment.proofImageId — one photo, one settlement.
  proofImageId Int?              @unique
  proofImage   ErrandProofImage? @relation(fields: [proofImageId], references: [id], onDelete: SetNull)

  settledAt       DateTime @default(now())

  @@index([riderId])
  @@map("settlement_records")
}

enum ProofImageKind {
  // Store receipt for goods bought on the customer's behalf. Thermal paper,
  // photographed in a shop — the hard OCR case, routed to Cloud Vision.
  RECEIPT
  // GCash / bank transfer confirmation. A digital screenshot, so crisp and
  // high-contrast — on-device ML Kit reads these without a network call.
  TRANSFER
  // Handover photo at the customer's door.
  PROOF_OF_DELIVERY
  // A purchase from a shop that issues no receipt at all -- a sari-sari store,
  // a market stall. The photo is of the GOODS, so there is nothing to read and
  // the OCR path is skipped entirely; the amount comes from the rider and is
  // marked unverified because nothing else can corroborate it.
  NO_RECEIPT
  // The CUSTOMER's own payment confirmation, uploaded from their phone when
  // they pay through the Facebook Page on a non-COD plan.
  PAYMENT_PROOF
  // The RIDER's photo of the customer's GCash/Maya receipt, taken at the door
  // when the customer shows it in person instead of (or in addition to)
  // uploading it themselves. Read by Cloud Vision with the same reference
  // number / amount / same-day rigor PAYMENT_PROOF gets — see
  // patterns/transferValidation.ts, shared by both.
  RIDER_BALANCE_PROOF
  // The RIDER's photo of physical cash in hand, for every cash collection —
  // ordinary COD, or a GCash/Maya customer who pays cash instead at the door.
  // No OCR: the rider's own typed figure is the amount, same as NO_RECEIPT.
  CASH_COLLECTED
}

enum ImageClarityVerdict {
  SHARP
  ACCEPTABLE
  // Rejected before any OCR runs. Spending a Cloud Vision call on an unreadable
  // photo costs money and still fails; better to ask for a retake immediately.
  TOO_BLURRY
  TOO_DARK
}

// 14f. Errand Proof Images (photographic evidence for one errand)
//
// Base64 in LongText, matching CustomerProfilePhoto and StoreCategoryImage — the
// established pattern in this schema. Clients downscale to ~1600px JPEG before
// upload, so a receipt lands near 300 KB rather than the 5 MB the validator caps
// at.
model ErrandProofImage {
  id       Int             @id @default(autoincrement())
  errandId String
  errand   Errand          @relation(fields: [errandId], references: [id], onDelete: Cascade)
  // Which stop this receipt came from. Null for a delivery photo, which happens
  // at the customer's address rather than at any store.
  pinpointId Int?
  pinpoint   ErrandPinpoint? @relation(fields: [pinpointId], references: [id], onDelete: SetNull)
  // Who captured this. Exactly one of the two is set.
  //
  // riderId was required, because every proof used to be a rider's: a receipt,
  // a handover photo. A customer's payment screenshot is evidence for the same
  // errand and belongs in the same table — same OCR path, same clarity scoring,
  // same viewing rules — but it has no rider behind it.
  riderId  Int?
  rider    User?           @relation(fields: [riderId], references: [id])
  customerId Int?
  customer   CustomerAccount? @relation(fields: [customerId], references: [id])

  kind      ProofImageKind
  imageData String         @db.LongText
  mimeType  String         @db.VarChar(30)
  byteSize  Int

  // Measured on the device before upload. Persisted rather than checked and
  // discarded: when an extracted total is disputed later, whether the photo was
  // legible in the first place is the first question worth answering.
  clarityScore   Float?
  clarityVerdict ImageClarityVerdict?

  capturedAt DateTime @default(now())

  // Whether a machine read this, or a person asserted it.
  //
  // False only for NO_RECEIPT: the figure is the rider's word. Kept as its own
  // column rather than inferred from `kind` so a report can rank exposure by
  // what is actually unverified without knowing every kind that might be.
  verified Boolean @default(true)

  // What the rider said they paid, where no receipt existed to read. Null on
  // every other kind, which carry their figure on the extraction instead.
  declaredTotal Float?

  // When a later upload replaced this one. Null means this is the CURRENT
  // proof for its (errandId, kind) — queries that want "the live one" filter
  // on supersededAt: null, exactly like they used to filter on the row simply
  // existing, back when a reupload deleted the old row outright instead of
  // marking it. Superseded rows are kept rather than deleted now: a rejected
  // or replaced screenshot is itself evidence in a fraud dispute, and the new
  // report (ErrandPayment.proofImage) needs history, not just whatever is
  // current right now, to stay trustworthy.
  supersededAt DateTime?

  extraction ReceiptExtraction?
  payment    ErrandPayment?
  settlement SettlementRecord?

  @@index([errandId])
  @@index([riderId])
  @@map("errand_proof_images")
}

enum OcrEngine {
  MLKIT
  CLOUD_VISION
}

enum OcrStatus {
  OK
  // Read something, but not confidently enough to pre-fill without a second look.
  NEEDS_REVIEW
  FAILED
}

// 14g. Receipt Extractions (OCR result for one proof image)
//
// Separate from the image on purpose: OCR is retryable and re-runnable on a
// different engine, and rawText is a second large blob that almost no query
// wants alongside the picture.
//
// The distinction that matters here is extractedTotal vs confirmedTotal. OCR
// proposes; the rider confirms. A misread digit must never silently become the
// figure a customer is charged, so both are kept and any divergence between them
// stays auditable.
model ReceiptExtraction {
  id           Int              @id @default(autoincrement())
  proofImageId Int              @unique
  proofImage   ErrandProofImage @relation(fields: [proofImageId], references: [id], onDelete: Cascade)

  engine  OcrEngine
  rawText String?   @db.LongText

  extractedTotal Float?
  extractedDate  DateTime?
  confidence     Float?
  status         OcrStatus @default(NEEDS_REVIEW)

  // Only a payment confirmation carries these. The reference is what makes a
  // payment findable again on the company's Facebook Page or bank statement —
  // an amount with no reference is a screenshot of nothing, so uploads without
  // one are rejected rather than stored.
  referenceNo   String? @db.VarChar(40)
  transactionId String? @db.VarChar(40)

  // What the rider actually accepted. Null until they confirm.
  confirmedTotal Float?
  confirmedAt    DateTime?

  extractedAt DateTime @default(now())

  @@map("receipt_extractions")
}

// 14h. Rider Commissions (payout snapshot, one row per completed errand)
//
// Snapshotted rather than computed on demand so a past payout cannot change
// under a rider's feet when a rate is edited, and so "why was I paid this?" has
// a stored answer showing the inputs as well as the result.
//
// itemCostExcluded records the money that was deliberately kept OUT of the
// split — the company fronts it for the goods, the rider only carries it. It is
// stored precisely because it is excluded: without it there is no evidence the
// exclusion happened.
model RiderCommission {
  id       Int    @id @default(autoincrement())
  errandId String @unique
  errand   Errand @relation(fields: [errandId], references: [id], onDelete: Cascade)
  riderId  Int
  rider    User   @relation(fields: [riderId], references: [id])

  deliveryFee    Float
  tip            Float
  commissionRate Float

  // riderShare = deliveryFee * rate + tip (the whole tip, never split).
  // businessShare = deliveryFee - (deliveryFee * rate).
  riderShare    Float
  businessShare Float

  itemCostExcluded Float

  computedAt DateTime @default(now())

  @@index([riderId])
  @@map("rider_commissions")
}

enum RiderPresenceStatus {
  ONLINE
  OFFLINE
}

// 14e. Rider Login Sessions Table (3NF: one row per rider login, closed on
// explicit logout or by the periodic presence sweep if abandoned — archival
// record of when riders were active and for how long)
model RiderLoginSession {
  id              Int       @id @default(autoincrement())
  riderId         Int
  rider           User      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  loginAt         DateTime  @default(now())
  logoutAt        DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())

  @@index([riderId])
  @@index([riderId, logoutAt])
  @@map("rider_login_sessions")
}

// 14f. Rider Status Logs Table (3NF: fixed-cadence archive — one row per
// rider every 2 minutes, not a change-log — of online/offline presence,
// written by jobs/riderStatusSnapshot.ts)
model RiderStatusLog {
  id         Int                 @id @default(autoincrement())
  riderId    Int
  rider      User                @relation(fields: [riderId], references: [id], onDelete: Cascade)
  status     RiderPresenceStatus
  recordedAt DateTime            @default(now())

  @@index([riderId, recordedAt])
  @@map("rider_status_logs")
}

// 15. Notifications Table (3NF: recipient is EITHER an operational User
// (owner/dispatcher/rider) OR a CustomerAccount, never both — enforced in
// notificationService.ts since MySQL has no clean "exactly one of two
// nullable FKs" constraint. Two nullable FKs (rather than one untyped
// recipientId + a type discriminator) so both sides keep real referential
// integrity, matching every other relation in this schema.)
model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int?
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId Int?
  customer   CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([customerId])
  @@map("notifications")
}

// 16. Account Modification Logs Table (3NF: unified audit trail of profile
// and account edits across all roles: Customer, Rider, Dispatcher, and Owner.
// Records field-level diffs, IP address, user-agent, and verification type.)
model AccountModificationLog {
  id            Int              @id @default(autoincrement())
  role          String // "CUSTOMER", "RIDER", "DISPATCHER", "OWNER"
  userId        Int?
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId    Int?
  customer      CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fieldModified String
  oldValue      String?          @db.Text
  newValue      String?          @db.Text
  ipAddress     String?
  userAgent     String?
  verifiedVia   String           @default("RECAPTCHA")
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([role])
  @@index([createdAt])
  @@map("account_modification_logs")
}

// 16b. Password Reset Attempts Table (3NF: one row per step of the customer
// "forgot password" flow). Deliberately NOT AccountModificationLog: that table
// requires a resolved account, and the rows most worth having here are the ones
// where no account resolved at all — an IP walking a list of usernames to learn
// which ones exist. `customerId` is therefore nullable, and `identifier` records
// what was actually searched for, whether or not it matched anything.
model PasswordResetAttempt {
  id         Int              @id @default(autoincrement())
  identifier String           @db.VarChar(255)
  customerId Int?
  customer   CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // REQUESTED | UNKNOWN_ACCOUNT | HONEYPOT | THROTTLED | COOLDOWN |
  // CODE_VERIFIED | CODE_REJECTED | COMPLETED — see
  // passwordResetService.ResetOutcome.
  outcome    String           @db.VarChar(32)
  ipAddress  String?          @db.VarChar(64)
  userAgent  String?          @db.Text
  createdAt  DateTime         @default(now())

  // The composite index is the one that matters: every throttle decision is a
  // "how many rows from this IP since T" count.
  @@index([ipAddress, createdAt])
  @@index([identifier])
  @@index([customerId])
  @@map("password_reset_attempts")
}

// 17. Verified Places Table (Pre-recorded GPS coordinates of establishments in Tacurong City)
model VerifiedPlace {
  id         String           @id @default(uuid()) @db.VarChar(36)
  name       String           @db.VarChar(150)
  categoryId Int
  category   MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  address    String           @db.VarChar(255)
  barangay   String?          @db.VarChar(80)
  latitude   Float
  longitude  Float
  keywords   String?          @db.Text
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Two relations to the same model, so both must be named: the place a
  // dispatcher pinned, and the place a rider was actually observed at.
  pinpoints         ErrandPinpoint[]   @relation("PinnedPlace")
  observedAt        ErrandPinpoint[]   @relation("ObservedPlace")
  dwellObservations DwellObservation[]

  @@index([name])
  @@index([categoryId])
  @@index([barangay])
  @@map("verified_places")
}

// 17. Errand Track Points (rider breadcrumb, 3NF: one row per accepted GPS fix)
//
// This is deliberately NOT the live-tracking channel. High-frequency live pins
// stay in Firebase RTDB (`riders/{id}`) exactly as before — see AGENTS.md
// section 7. What lands here is a low-rate, map-matched archive flushed from the
// rider device roughly once a minute, including everything it buffered while
// offline. It exists for three things the live channel cannot provide: learning
// real dwell times, replaying a route when a delivery is disputed, and giving
// dispatch a server-side position to rank riders by.
model ErrandTrackPoint {
  id       Int    @id @default(autoincrement())
  errandId String
  errand   Errand @relation(fields: [errandId], references: [id], onDelete: Cascade)
  riderId  Int
  rider    User   @relation("RiderTrackPoints", fields: [riderId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float

  accuracyMeters Float?
  speedMps       Float?
  headingDeg     Float?

  // recordedAt is the device clock at the moment of the fix; receivedAt is the
  // server clock when it arrived. They diverge by minutes or hours for points
  // buffered through a signal blackout, which is exactly why both are kept —
  // ordering the trail uses recordedAt, auditing the flush uses receivedAt.
  recordedAt DateTime
  receivedAt DateTime @default(now())

  // True once the point has been snapped to the road network. False means the
  // raw GPS was kept because matching was unavailable or untrustworthy.
  isMapMatched Boolean @default(false)
  // True when this fix was buffered on the device during a connectivity gap.
  wasOffline   Boolean @default(false)

  // Device-generated UUID. Paired with the unique index below it makes a
  // retried batch idempotent — a flush that times out after the server already
  // committed must not duplicate the trail on retry.
  clientPointId String @db.VarChar(36)

  @@unique([errandId, clientPointId])
  @@index([errandId, recordedAt])
  @@index([riderId, recordedAt])
  @@map("errand_track_points")
}

// 18. Dwell Observations (3NF: one row per completed stop)
//
// The training set behind MerchantCategory's dwell percentiles. Keeping the raw
// observations rather than only a running aggregate means the percentiles can be
// recomputed, audited, or corrected after the fact.
model DwellObservation {
  id         Int            @id @default(autoincrement())
  errandId   String
  errand     Errand         @relation(fields: [errandId], references: [id], onDelete: Cascade)
  pinpointId Int
  pinpoint   ErrandPinpoint @relation(fields: [pinpointId], references: [id], onDelete: Cascade)

  categoryId Int?
  category   MerchantCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  placeId    String?           @db.VarChar(36)
  place      VerifiedPlace?    @relation(fields: [placeId], references: [id], onDelete: SetNull)

  dwellSeconds Int
  arrivedAt    DateTime
  departedAt   DateTime

  // Whether this dwell ran far past what this kind of shop usually takes.
  //
  // detectStalledStop computed exactly this and threw it away -- it emitted a
  // socket event and returned, so a rider who queues for forty minutes at every
  // supermarket left no trace anyone could look at later. Stored so the pattern
  // is trendable, and deliberately kept OUT of any amount at risk: a long queue
  // is a judgement about time, not a claim about money.
  stalled      Boolean  @default(false)

  createdAt    DateTime @default(now())

  @@index([categoryId, createdAt])
  @@index([placeId, createdAt])
  @@map("dwell_observations")
}
