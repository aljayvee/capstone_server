# Firebase Admin service accounts. These are private keys with full project
# authority, unlike the public client config that ships in the app bundles.
# Never commit one: anyone holding it can read and write the entire Realtime
# Database regardless of the security rules.
*firebase-adminsdk*.json
firebase-service-account*.json

# Real receipts (names, phone numbers, reference numbers) used to tune the
# receipt parser, and debug screenshots of live maps. This repository is
# public on GitHub: personal data stays on the machine.
Training_Data_*/
/Innacurate ETA and route line issues when zoom in/
*.stackdump

# Google Places request counts (lib/places/placesBudget.ts), kept on the server
/var/
