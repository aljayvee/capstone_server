# Dependencies
node_modules/

# Production output
dist/

# Environment files & secrets
.env
.env.local

# Logs
*.log
npm-debug.log*

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

.agents/

# OSRM routing graph + downloaded OSM extracts (rebuilt via gis/build-graph.ps1)
gis/data/
gis/verified-places.geojson

# Firebase Admin service accounts. These are private keys with full project
# authority, unlike the public client config that ships in the app bundles.
# Never commit one: anyone holding it can read and write the entire Realtime
# Database regardless of the security rules.
*firebase-adminsdk*.json
firebase-service-account*.json

# Real receipts (names, phone numbers, reference numbers) used to tune the
# receipt parser, and debug screenshots of live maps. This repository is
# public on GitHub: personal data stays on the machine.
Training_Data_*/
/Innacurate ETA and route line issues when zoom in/
*.stackdump

# Google Places request counts (lib/places/placesBudget.ts), kept on the server
/var/

# State the running server writes for itself, which exists only on the VPS.
# Nightly database dumps (jobs/nightlyBackup.ts) hold every customer's
# personal data; a `git add -A` on the VPS must never be able to publish them.
/backups/
/config/app-releases.json
/config/maintenance.json
# Written at every start and clean stop (lib/processState.ts).
/config/process-state.json
/config/process-state.json.*.tmp
/config/log-retention.json
/config/log-retention-state.json
/config/log-retention*.tmp
# Release APKs served from public/downloads (appReleaseService.ts), 100+ MB
# each, over GitHub's file size limit.
/public/downloads/
.env.bak
*.stale_bak
